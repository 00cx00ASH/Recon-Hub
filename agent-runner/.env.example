# Copie pra .env (não versionado) e ajuste. run.py carrega esse arquivo
# sozinho se ele existir ao lado do script.

# Obrigatório: qual programa (./programs/<nome>.json) explorar.
AGENT_PROGRAM=acme

# Opcional: instrução livre além do padrão ("explore seguindo a esteira").
# AGENT_GOAL=foca em JS/API primeiro, já rodei o recon passivo ontem

# Modelo — troque livremente entre execuções. Exemplos válidos hoje:
# claude-opus-5 (mais capaz, mais caro), claude-sonnet-5 (padrão, bom
# equilíbrio), claude-haiku-4-5-20251001 (mais barato/rápido).
AGENT_MODEL=claude-sonnet-5
# AGENT_FALLBACK_MODEL=claude-haiku-4-5-20251001

# Limites — o processo Python aplica esses tetos de verdade (não é só o
# próprio agente "se controlando" pelo system prompt).
AGENT_MAX_ROUNDS=20
AGENT_MAX_RUNTIME_MIN=180
AGENT_MAX_COST_USD=5.0
AGENT_MAX_TURNS_PER_ROUND=40

# Onde os logs de cada execução ficam (um arquivo por run).
# AGENT_LOG_DIR=./logs

# --- Conexão com o hub (mesma convenção do cmd/reconhub-mcp) ---
RECONHUB_URL=http://127.0.0.1:7878
# RECONHUB_TOKEN=...            # se vazio, lê ../data/token automaticamente
# RECONHUB_TOKEN_FILE=/caminho/alternativo/pro/token

# --- Pago vs. "de graça" (inclusa na assinatura) ---
# Setado -> a CLI usa API paga por token com esta chave.
# Vazio/ausente -> a CLI cai pro login/assinatura já configurado na máquina
# (o mesmo que já usa quando você roda `claude` interativo aqui).
# ANTHROPIC_API_KEY=sk-ant-...
