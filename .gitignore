/data/
/.env
# programas de bug bounty são dado local/privado (escopo real, às vezes sob
# confidencialidade do próprio programa) — nunca vão pro histórico do git.
# example.json é o único template genérico, fica versionado de propósito.
/programs/*.json
!/programs/example.json
/programs-backup/
/reconhub
/reconhub-sqlite
/reconhub-mcp
/reconhub-cli
reconhub.db
reconhub.db-shm
reconhub.db-wal
/config.json
*.log
.DS_Store
/watches/*.json
/.claude/scheduled_tasks.lock

# cada tools/<nome>/ é um módulo Go próprio — `go build ./...` sem -o ali
# gera um binário com o nome da pasta; nunca deve ser versionado.
